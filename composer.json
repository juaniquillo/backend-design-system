{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "juaniquillo/backend-design-system",
    "description": "Laravel design system: PHP components, Tailwind theme files, config-driven designs.",
    "keywords": [
        "laravel",
        "juaniquillo",
        "backend-design-system"
    ],
    "homepage": "https://github.com/juaniquillo/backend-design-system",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Victor Sánchez",
            "email": "juaniquillo@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "juaniquillo/base-backend-component": "^0.1.0",
        "juaniquillo/laravel-backend-component": "^0.12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.0||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Juaniquillo\\BackendDesignSystem\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Juaniquillo\\BackendDesignSystem\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": "vendor/bin/pint --parallel",
        "lint:check": "vendor/bin/pint --parallel --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "rector": "vendor/bin/rector process",
        "rector:check": "vendor/bin/rector process --dry-run",
        "test:unit": "@php bin/pest.php",
        "test:types": "vendor/bin/pest --type-coverage --min=100",
        "qa": [
            "@analyse",
            "@rector:check",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "support": {
        "issues": "https://github.com/juaniquillo/backend-design-system/issues",
        "source": "https://github.com/juaniquillo/backend-design-system"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Juaniquillo\\BackendDesignSystem\\BackendDesignSystemServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
